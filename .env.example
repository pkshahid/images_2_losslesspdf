# Telegram bot token from @BotFather. Required for the bot to work.
# Leave unset if you only want the web UI.
TELEGRAM_BOT_TOKEN=

# Public base URL where this app is reachable, e.g. https://your-domain.com
# Used to register the Telegram webhook. On Vercel, VERCEL_URL is auto-set.
BOT_WEBHOOK_URL=
